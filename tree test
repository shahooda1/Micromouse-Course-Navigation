class Node:
    
    def __init__ (self, data):
        
        self.data = data
        self.children = []

    def insertLeft(self, data):
        
        newNode = Node(data)
        self.children.insert(0, newNode)
        return newNode
    
    def insertRight(self, data):
        
        newNode = Node(data)
        self.children.insert(2, newNode)
        return newNode
        
    def insertCenter(self, data):
        
        newNode = Node(data)
        self.children.insert(1, newNode)
        return newNode
    
