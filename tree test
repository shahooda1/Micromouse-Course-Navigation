class Node:
    
    def __init__ (self, data, depth):
        
        self.data = data
        self.left = None
        self.center = None
        self.right = None
        
        self.depth = depth
        
    def insertLeft(self, data, depth):
        
        self.left = Node(data, depth)
        return self.left
    
    def insertCenter (self, data, depth):
    
        self.center = Node(data, depth)
        return self.center
    
    def insertRight (self, data, depth):
        
        self.right = Node(data, depth)
        return self.right
    

    def printTree (self):
        
        print("-" * self.depth, end="")
        print(self.data)
        
        
        if self.left:
            
            print("L: ", end="")
            self.left.printTree()
        
        if self.center:
            
            print("C: ", end="")
            self.center.printTree()
            
        if self.right:
            
            print("R: ", end="")
            self.right.printTree()


        
