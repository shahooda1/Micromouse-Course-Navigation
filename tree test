
class Node:
    
    def __init__ (self, data):
        
        self.data = data
        self.left = None
        self.right = None
        self.center = None
        
        self.depth = 0
        
    def insertLeft(self, data):
        
        self.left = Node(data)
        self.left.depth = self.depth + 1
        return self.left
    
    def insertRight (self, data):
        
        self.right = Node(data)
        self.right.depth = self.depth + 1
        return self.right
    
    def insertCenter (self, data):
    
        self.center = Node(data)
        self.center.depth = self.depth + 1
        return self.center
        
    def printTree (self):
        
        print(self.data)
        
        if self.left:
            
            self.left.printTree()
        
        if self.center:
            
            self.center.printTree()
            
        if self.right:
            
            self.right.printTree()

        
