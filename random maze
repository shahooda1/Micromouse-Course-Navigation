import random

class Node:
    def __init__(self, data):
        
        self.data = data
        
        self.left = None
        self.center = None
        self.right = None
        
        self.isEnd = False
        
    def insertLeft(self, data):
        self.left = Node(data)
        return self.left
    
    def insertCenter(self, data):
        self.center = Node(data)
        return self.center
    
    def insertRight(self, data):
        self.right = Node(data)
        return self.right
        
    #function to print tree
    def printTree(self, level = 0):
        
        print(str(self.data))
        
        if self.left:
            
            print("--" * level + "L: ", end="")
            self.left.printTree(level + 1)
        
        if self.center:
            
            print("--" * level + "C: ", end="")
            self.center.printTree(level + 1)

        if self.right:

            print("--" * level + "R: ", end="")
            self.right.printTree(level + 1)

        
        
def createRandomChildren(node, depth, maxDepth, counter):
    if depth > maxDepth:
    
        return counter
        
    #determining how many branches come from the node
    branches = random.randint(1, 3)
    
    #what branch is left
    available = ["left", "center", "right"]
    random.shuffle(available)
    
    #adding children to the nodes
    for i in range(branches):
        branch = available[i]
        
        counter += 1
        
        if branch == "left":
            child = node.insertLeft(counter)
        elif branch == "center":
            child = node.insertCenter(counter)
        else:
            child = node.insertRight(counter)
            
        if counter == 10:
            child.isEnd = True
            
            
            
        #counter is the name of the node because it counts up from 1 when it adds the next one
        counter = createRandomChildren(child, depth + 1, maxDepth, counter)
    return counter

#function that creates the tree with the specified start node and depth
def randomizeMaze(start, maxDepth = 4):
    createRandomChildren(start, 1, maxDepth, 0)
    
