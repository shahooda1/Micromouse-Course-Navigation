import random

#creating a class for each cell of the maze
class Node:
    def __init__(self, data):
        
        self.data = data
        
        self.left = None
        self.center = None
        self.right = None

#functions to insert nodes at certain positions
    def insertLeft(self, data):
        self.left = Node(data)
        return self.left
    
    def insertCenter(self, data):
        self.center = Node(data)
        return self.center
    
    def insertRight(self, data):
        self.right = Node(data)
        return self.right
        
    #function for printing tree with proper indentation
    def printTree(self, level = 0):
        
        print(self.data)
        
        if self.left:
            
            print(" " * level + "L: ", end="")
            self.left.printTree(level + 1)
        
        if self.center:
            
            print(" " * level + "C: ", end="")
            self.center.printTree(level + 1)
            
        if self.right:
            
            print(" " * level + "R: ", end="")
            self.right.printTree(level + 1)
            
        
